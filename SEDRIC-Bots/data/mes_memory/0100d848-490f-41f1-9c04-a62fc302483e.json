[
 {
  "id": "mem1a1821beec238bcd8",
  "text": "加工单报工前必须先让加工单和工序都进入「进行中」：在加工单详情点「开始」，再在「工序流程」里对该工序点「开始工序」，否则报工会被拦下。",
  "by": "Bot（本地管理员）",
  "source": "s1a181cb52b0eeae25",
  "created": 1793184231106,
  "updated": 1793184231106
 },
 {
  "id": "mem1a1821beec3d28550",
  "text": "报工弹窗里填「良品数」后点「仅报工」即可提交；良品数达到计划数量时系统会自动把工序标为「已完成」，无需再点「完成」。",
  "by": "Bot（本地管理员）",
  "source": "s1a181cb52b0eeae25",
  "created": 1793184231107,
  "updated": 1793184231107
 },
 {
  "id": "mem1a1821beec4ec8c80",
  "text": "页面元素编号会因页面刷新或跳转失效，点击前若提示编号已失效，需重新查看当前页面清单再点。",
  "by": "Bot（本地管理员）",
  "source": "s1a181cb52b0eeae25",
  "created": 1793184231108,
  "updated": 1793184231108
 },
 {
  "id": "mem1a182334e07ba6d60",
  "text": "建工艺路线前必须先确认所需工序已存在：在「生产管理 → 工序管理」用「新增工序」逐一建好，否则工艺路线里选不到这些工序。",
  "by": "Bot（本地管理员）",
  "source": "s1a181cb52b0eeae25",
  "created": 1793185762823,
  "updated": 1793185762823
 },
 {
  "id": "mem1a182334e09315c38",
  "text": "在工艺路线「新增」页用「选择工序」下拉添加工序时，即使提示「点了选项但没有选上」，工序实际已加入下方表格，可继续追加，无需重复操作。",
  "by": "Bot（本地管理员）",
  "source": "s1a181cb52b0eeae25",
  "created": 1793185762825,
  "updated": 1793185762825
 },
 {
  "id": "mem1a182334e0bfe1940",
  "text": "新增工序弹窗提交后页面元素编号会重排，连续新建多道工序时每次都要重新查看当前弹窗元素再填写，否则会点到菜单等错误元素。",
  "by": "Bot（本地管理员）",
  "source": "s1a181cb52b0eeae25",
  "created": 1793185762827,
  "updated": 1793185762827
 },
 {
  "id": "mem1a18238240d7aa439",
  "text": "新增供应商走左侧「供应/采购」→「供应商管理」→「新增」，弹窗中仅「供应商名称」必填，填好后点「确定」即保存，供应商编号留空会自动生成。",
  "by": "Bot（本地管理员）",
  "source": "s1a1821a30d821b116",
  "created": 1793186079757,
  "updated": 1793186079757
 },
 {
  "id": "mem1a1823a586e08a48f",
  "text": "在合同「新增」页添加合同商品：在「合同商品」区点「+ 选择合同商品」勾选商品，再逐行填「单价」「销售数量」。",
  "by": "Bot（本地管理员）",
  "source": "s1a1821a30d821b116",
  "created": 1793186224238,
  "updated": 1793186224238
 },
 {
  "id": "mem1a1823a586fdba5d1",
  "text": "合同商品只能在客户管理 → 合同订单 → 新增 → 直接创建的「合同商品」区添加，不在商品管理里维护。",
  "by": "Bot（本地管理员）",
  "source": "s1a1821a30d821b116",
  "created": 1793186224239,
  "updated": 1793186224239
 },
 {
  "id": "mem1a1823b6a99176be6",
  "text": "新增商品时「类别」下拉只有外协加工、半成品、包材配件、成品，没有「原材料」，外购配件类商品选「包材配件」即可。",
  "by": "Bot（本地管理员）",
  "source": "s1a1821a30d821b116",
  "created": 1793186294425,
  "updated": 1793186294425
 },
 {
  "id": "mem1a1823b6a9a809104",
  "text": "新增商品弹窗中「商品名」「单位」为必填，商品编号可留空自动生成，填好后点「保存」即建好。",
  "by": "Bot（本地管理员）",
  "source": "s1a1821a30d821b116",
  "created": 1793186294426,
  "updated": 1793186294426
 },
 {
  "id": "mem1a1823b6a9ccd4f24",
  "text": "供应商和客户是两套档案：在「供应/采购 → 供应商管理」建的是供应商，合同商品需要先在「客户管理」里有客户才能建合同。",
  "by": "Bot（本地管理员）",
  "source": "s1a1821a30d821b116",
  "created": 1793186294428,
  "updated": 1793186294428
 },
 {
  "id": "mem1a1823e376671bdbe",
  "text": "合同订单新增页的「新增」是浮层菜单，需先点「直接创建」才弹出「新增合同」弹窗，点「报价单创建」走的是另一条路径。",
  "by": "Bot（本地管理员）",
  "source": "s1a1821a30d821b116",
  "created": 1793186477926,
  "updated": 1793186477926
 },
 {
  "id": "mem1a1823e3768c3e321",
  "text": "合同商品区点「+ 选择合同商品」后，在「选择商品」弹窗勾选商品再点确认即可加入，商品必须先在「商品管理 → 商品列表」建好才能选到。",
  "by": "Bot（本地管理员）",
  "source": "s1a1821a30d821b116",
  "created": 1793186477928,
  "updated": 1793186477928
 },
 {
  "id": "mem1a1823e3769e178c7",
  "text": "合同商品加入后「销售总数」「合同金额」为不可用只读字段，需在合同商品表格行内填「单价」「销售数量」，系统自动汇总。",
  "by": "Bot（本地管理员）",
  "source": "s1a1821a30d821b116",
  "created": 1793186477929,
  "updated": 1793186477929
 },
 {
  "id": "mem1a187cfe2c8ea23b6",
  "text": "团队管理新增团队：点页面右上角「新 增」打开「新增团队」弹窗（此处「团队主管」是下拉框，可直接 select）；不要用列表区那个「新增团队」按钮，那个弹窗的主管只是文本框，填进去点确定不会保存成功。",
  "by": "Bot（本地管理员）",
  "source": "s1a1821a30d821b116",
  "created": 1793279910600,
  "updated": 1793279910600
 },
 {
  "id": "mem1a187cff494f19e20",
  "text": "系统管理 → 部门管理新增部门：点「+ 新增」打开「新增部门信息」，只填「名称」、上级部门可不选，点「确 定」即保存；在部门行点「新增下级部门」会自动带好上级部门。",
  "by": "Bot（本地管理员）",
  "source": "s1a1821a30d821b116",
  "created": 1793279915156,
  "updated": 1793279915156
 }
]